{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-qa.local/schemas/advice.schema.json",
  "title": "Unverified, read-only review suggestions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_sha256", "summary", "limitations", "recommendations"],
  "properties": {
    "schema_version": { "const": 1 },
    "asset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "limitations": {
      "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "recommendations": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "finding_ids", "priority", "action", "rationale", "uncertainty"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{4}$" },
          "finding_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^F[0-9]{4}$" } },
          "priority": { "enum": ["high", "medium", "low"] },
          "action": { "enum": ["review_reference", "review_numeric_data", "review_animation_timing", "review_animation_channel", "manual_visual_review"] },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
          "uncertainty": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
